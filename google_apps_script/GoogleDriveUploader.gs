/**
 * ⏰ BU FONKSİYONU 1 KERE ÇALIŞTIRIN:
 * Her gün saat 16:00'da Google Bulutunda otomatik çalışan tetikleyiciyi kurar.
 */
function otomatik1600TetikleyiciKur() {
  var triggers = ScriptApp.getProjectTriggers();
  for (var i = 0; i < triggers.length; i++) {
    if (triggers[i].getHandlerFunction() === "sendDaily1600WhatsApp") {
      ScriptApp.deleteTrigger(triggers[i]);
    }
  }

  ScriptApp.newTrigger("sendDaily1600WhatsApp")
    .timeBased()
    .everyDays(1)
    .atHour(16)
    .create();

  Logger.log("🎉 TEBRİKLER HOCAM! 'MÜFİT HOCA İLE MATEMATİK' Grubu İçin Saat 16:00 Tetikleyicisi Kuruldu.");
}

/**
 * 🧪 HEMEN ŞİMDİ TEST ET:
 * Saat 16:00'ı beklemeden gruba hemen bugünün test ödevini atmak için bu fonksiyonu çalıştırın.
 */
function testWhatsAppGonder() {
  var res = sendDaily1600WhatsApp();
  Logger.log("Test Sonucu: " + JSON.stringify(res));
}

function sendDaily1600WhatsApp() {
  try {
    var todayStr = Utilities.formatDate(new Date(), "GMT+3", "yyyy-MM-dd");
    Logger.log("⏰ Saat 16:00 WhatsApp Gönderimi Başladı: " + todayStr);

    var messageText = getDailyMessageText(todayStr);

    var greenUrl = GREEN_API_HOST + "/waInstance" + GREEN_API_INSTANCE_ID + "/sendMessage/" + GREEN_API_TOKEN;
    var greenPayload = {
      chatId: WHATSAPP_GRUP_ID,
      message: messageText
    };

    var greenResp = UrlFetchApp.fetch(greenUrl, {
      method: "post",
      contentType: "application/json",
      payload: JSON.stringify(greenPayload),
      muteHttpExceptions: true
    });

    var resultText = greenResp.getContentText();
    Logger.log("✅ Green-API Yanıtı: " + resultText);
    return { status: "success", response: resultText, targetChatId: WHATSAPP_GRUP_ID, date: todayStr };

  } catch (err) {
    Logger.log("❌ WhatsApp Gönderim Hatası: " + err.toString());
    return { status: "error", error: err.toString() };
  }
}

/**
 * Günün tarihine göre 237 günlük müfredattan Mete ve Ege'nin testlerini hazırlar
 */
function getDailyMessageText(dateStr) {
  var dInfo = GUNLUK_PROGRAM_LISTESI[dateStr];
  if (!dInfo) {
    // Takvim dışı günler için varsayılan mesaj
    return "📅 *GÜNLÜK ÇALIŞMA BİLDİRİMİ (Saat 16:00)*\n" +
           "🗓 *Tarih:* " + dateStr + "\n" +
           "👨‍🏫 *Öğretmen:* Müfit Hoca\n" +
           "━━━━━━━━━━━━━━━━━━━━━\n\n" +
           "Bugün için planlanmış resmi ödev testi bulunmamaktadır. Konu eksiklerinizi ve çözemediğiniz soruları tekrar edebilirsiniz.\n\n" +
           "🚀 İyi çalışmalar gençler!";
  }

  var isWeekend = dInfo.isWeekend;
  var dayNum = dInfo.day;
  var tests = dInfo.tests;

  var msg = "📅 *GÜNLÜK ÖDEV VE ÇALIŞMA BİLDİRİMİ (Saat 16:00)*\n" +
            "🗓 *Tarih:* " + dateStr + " (" + (isWeekend ? "Hafta Sonu • 2 Test" : "Hafta İçi • 1 Test") + ")\n" +
            "📌 *İlerleme:* Gün " + dayNum + " / 237\n" +
            "👨‍🏫 *Öğretmen:* Müfit Hoca\n" +
            "━━━━━━━━━━━━━━━━━━━━━\n\n" +
            "👨‍🎓🧑‍🎓 *METE VE EGE'NİN BUGÜNKÜ TEST GÖREVİ:*\n";

  for (var i = 0; i < tests.length; i++) {
    var t = tests[i];
    var slot = isWeekend ? (i === 0 ? "1. Test (Öğlen Öncesi)" : "2. Test (Öğleden Sonra)") : "Günün Testi";
    msg += "🔹 *" + slot + "*\n" +
           "   📚 Kitap: " + t.book + "\n" +
           "   📂 Konu: " + t.topic + "\n" +
           "   📝 Test: " + t.test + (t.pages ? " • Sayfa " + t.pages : "") + "\n" +
           "   ❓ Soru Sayısı: " + t.q + " Soru\n\n";
  }

  msg += "━━━━━━━━━━━━━━━━━━━━━\n" +
         "📸 *ÖNEMLİ KURAL & HATIRLATMA:*\n" +
         "• Testleri mutlaka süre tutarak ve dikkatinizi dağıtmadan çözünüz.\n" +
         "• Çözemediğiniz veya takıldığınız soruların fotoğrafını sisteme yükleyiniz (Sorular anında Müfit Hoca'nın Google Drive arşivine aktarılır).\n" +
         "• Test sonuçlarınızı çözdükten hemen sonra sisteme giriniz.\n\n" +
         "🚀 Başarılar Mete & Ege, iyi çalışmalar!";

  return msg;
}

